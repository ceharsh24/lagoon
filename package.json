{
  "name": "lagoon-color-theme",
  "displayName": "Lagoon Color Theme",
  "description": "A calm teal-on-indigo dark theme with dimmed and light variants. Pastel syntax, one-hue indigo UI, and every colour contrast-checked for long editing sessions.",
  "version": "1.1.0",
  "publisher": "lagoon",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://ceharsh24.github.io/lagoon/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ceharsh24/lagoon.git"
  },
  "bugs": {
    "url": "https://github.com/ceharsh24/lagoon/issues"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "dark theme",
    "light theme",
    "teal",
    "indigo",
    "pastel",
    "italic",
    "accessible"
  ],
  "galleryBanner": {
    "color": "#161523",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Lagoon",
        "uiTheme": "vs-dark",
        "path": "./themes/lagoon.json"
      },
      {
        "label": "Lagoon Soft",
        "uiTheme": "vs-dark",
        "path": "./themes/lagoon-soft.json"
      },
      {
        "label": "Lagoon Dawn",
        "uiTheme": "vs",
        "path": "./themes/lagoon-dawn.json"
      }
    ]
  },
  "scripts": {
    "build": "node src/build.js && node src/icon.js && node src/preview.js",
    "check": "node src/build.js --check",
    "icon": "node src/icon.js",
    "preview": "node src/preview.js"
  }
}
