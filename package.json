{
  "name": "lagoon",
  "displayName": "Lagoon",
  "description": "A teal-on-indigo theme. Monochromatic indigo chrome, pastel split-complementary syntax, WCAG-audited contrast. Dark, Soft, and Dawn variants.",
  "version": "1.0.0",
  "publisher": "ceharsh24",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://ceharsh24.github.io/lagoon/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ceharsh24/lagoon.git"
  },
  "bugs": {
    "url": "https://github.com/ceharsh24/lagoon/issues"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "dark theme",
    "light theme",
    "teal",
    "indigo",
    "pastel",
    "accessible"
  ],
  "galleryBanner": {
    "color": "#161523",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Lagoon",
        "uiTheme": "vs-dark",
        "path": "./themes/lagoon.json"
      },
      {
        "label": "Lagoon Soft",
        "uiTheme": "vs-dark",
        "path": "./themes/lagoon-soft.json"
      },
      {
        "label": "Lagoon Dawn",
        "uiTheme": "vs",
        "path": "./themes/lagoon-dawn.json"
      }
    ]
  },
  "scripts": {
    "build": "node src/build.js && node src/icon.js && node src/preview.js",
    "check": "node src/build.js --check",
    "icon": "node src/icon.js",
    "preview": "node src/preview.js"
  }
}
